{
  "version": 1,
  "strategy": "split",
  "dir": "tools",
  "go_version": "inherit",
  "module_prefix": "github.com/piusalfred/httpstats",
  "settings": {
    "jobs": 1,
    "lock_stale_timeout": 300,
    "lock_timeout": 10,
    "no_lock": false,
    "offline": false,
    "operation_timeout": 120,
    "trace": false,
    "verbose": false
  },
  "tools": {
    "lefthook": {
      "source": "go",
      "package": "github.com/evilmartians/lefthook/v2",
      "version": "v2.1.10"
    },
    "lint": {
      "source": "go",
      "package": "github.com/golangci/golangci-lint/v2/cmd/golangci-lint",
      "version": "v2.12.2"
    },
    "addlicense": {
      "source": "go",
      "package": "github.com/google/addlicense",
      "version": "v1.2.0"
    },
    "yamlfmt": {
      "source": "go",
      "package": "github.com/google/yamlfmt/cmd/yamlfmt",
      "version": "v0.21.0"
    },
    "tparse": {
      "source": "go",
      "package": "github.com/mfridman/tparse",
      "version": "v0.18.0"
    },
    "mdlint": {
      "source": "go",
      "package": "github.com/shinagawa-web/gomarklint/v3",
      "version": "v3.3.0"
    },
    "vulncheck": {
      "source": "go",
      "package": "golang.org/x/vuln/cmd/govulncheck",
      "version": "v1.7.0"
    }
  }
}
